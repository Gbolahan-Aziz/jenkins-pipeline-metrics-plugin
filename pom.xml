<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.jenkins-ci.plugins</groupId>
    <artifactId>plugin</artifactId>
    <version>6.2221.va_045130417c9</version>
    <relativePath/>
  </parent>

  <groupId>io.jenkins.plugins</groupId>
  <artifactId>pipeline-metrics</artifactId>
  <version>${changelist}</version>
  <packaging>hpi</packaging>

  <name>Pipeline Metrics</name>
  <description>Native, in-process Jenkins build and stage metrics with an analytics dashboard.</description>
  <url>https://github.com/jenkinsci/${project.artifactId}-plugin</url>

  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/licenses/MIT</url>
    </license>
  </licenses>

  <scm child.scm.connection.inherit.append.path="false" child.scm.developerConnection.inherit.append.path="false"
       child.scm.url.inherit.append.path="false">
    <connection>scm:git:https://github.com/${gitHubRepo}.git</connection>
    <developerConnection>scm:git:https://github.com/${gitHubRepo}.git</developerConnection>
    <tag>${scmTag}</tag>
    <url>https://github.com/${gitHubRepo}</url>
  </scm>

  <properties>
    <changelist>999999-SNAPSHOT</changelist>
    <gitHubRepo>jenkinsci/${project.artifactId}-plugin</gitHubRepo>
    <!-- https://www.jenkins.io/doc/developer/plugin-development/choosing-jenkins-baseline/ -->
    <jenkins.baseline>2.555</jenkins.baseline>
    <jenkins.version>${jenkins.baseline}.3</jenkins.version>
    <hpi.strictBundledArtifacts>true</hpi.strictBundledArtifacts>
    <!-- The DB drivers/pool below aren't provided by Jenkins core, so they must be bundled;
         slf4j-api is HikariCP's own transitive dependency. Pinning this list means any future,
         unintended library creep fails the build instead of silently bloating the .hpi. -->
    <hpi.bundledArtifacts>HikariCP,mariadb-java-client,postgresql,slf4j-api,sqlite-jdbc</hpi.bundledArtifacts>
    <banObsoleteDependencyOverrides.skip>false</banObsoleteDependencyOverrides.skip>
    <ban-junit4-imports.skip>false</ban-junit4-imports.skip>
    <ban-deprecated-stapler.skip>false</ban-deprecated-stapler.skip>
    <ban-commons-lang-2.skip>false</ban-commons-lang-2.skip>
    <sqlite.jdbc.version>3.46.1.3</sqlite.jdbc.version>
    <hikaricp.version>5.1.0</hikaricp.version>
    <postgresql.jdbc.version>42.7.4</postgresql.jdbc.version>
    <mariadb.jdbc.version>3.4.1</mariadb.jdbc.version>
    <testcontainers.version>1.21.4</testcontainers.version>
  </properties>

  <repositories>
    <repository>
      <id>repo.jenkins-ci.org</id>
      <url>https://repo.jenkins-ci.org/public/</url>
    </repository>
  </repositories>
  <pluginRepositories>
    <pluginRepository>
      <id>repo.jenkins-ci.org</id>
      <url>https://repo.jenkins-ci.org/public/</url>
    </pluginRepository>
  </pluginRepositories>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.jenkins.tools.bom</groupId>
        <artifactId>bom-${jenkins.baseline}.x</artifactId>
        <version>7020.vf38cb_40380d1</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <!-- Provides Chart.js to every Jenkins page via a PageDecorator, so the dashboard gets it
           for free instead of this plugin vendoring and hand-maintaining its own copy of a
           third-party JS library (the update center's convention for shared frontend
           dependencies, e.g. jquery3-api/bootstrap5-api). -->
      <groupId>io.jenkins.plugins</groupId>
      <artifactId>chartjs-api</artifactId>
      <version>4.2.1.5</version>
    </dependency>
    <dependency>
      <groupId>org.jenkins-ci.plugins.workflow</groupId>
      <artifactId>workflow-job</artifactId>
    </dependency>
    <dependency>
      <groupId>org.jenkins-ci.plugins.workflow</groupId>
      <artifactId>workflow-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.jenkins-ci.plugins</groupId>
      <artifactId>structs</artifactId>
    </dependency>
    <dependency>
      <groupId>org.jenkins-ci.plugins</groupId>
      <artifactId>credentials</artifactId>
    </dependency>
    <dependency>
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
      <version>${sqlite.jdbc.version}</version>
    </dependency>
    <dependency>
      <groupId>com.zaxxer</groupId>
      <artifactId>HikariCP</artifactId>
      <version>${hikaricp.version}</version>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <version>${postgresql.jdbc.version}</version>
      <exclusions>
        <!-- Compile-time-only nullness annotations; not needed at runtime, so exclude it rather
             than bundle dead weight into the .hpi. -->
        <exclusion>
          <groupId>org.checkerframework</groupId>
          <artifactId>checker-qual</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <!-- LGPL-2.1; speaks the MySQL wire protocol against both MySQL and MariaDB servers, so
           this one driver covers "MySQL/MariaDB" without bundling the GPL mysql-connector-j. -->
      <groupId>org.mariadb.jdbc</groupId>
      <artifactId>mariadb-java-client</artifactId>
      <version>${mariadb.jdbc.version}</version>
      <exclusions>
        <!-- Windows Integrated Auth (SSPI) support, irrelevant on a Jenkins controller and pulls
             in a caffeine version older than the one the Jenkins BOM already manages. -->
        <exclusion>
          <groupId>com.github.waffle</groupId>
          <artifactId>waffle-jna</artifactId>
        </exclusion>
      </exclusions>
    </dependency>

    <dependency>
      <groupId>io.jenkins.configuration-as-code</groupId>
      <artifactId>test-harness</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.jenkins-ci.plugins</groupId>
      <artifactId>plain-credentials</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- Test-only: lets StageExtractorTest run a real `parallel` pipeline through the CPS
           engine and inspect its actual FlowNode graph, rather than trusting hand-built
           FlowNode mocks for a fix that specifically depends on real block-start/end pairing. -->
      <groupId>org.jenkins-ci.plugins.workflow</groupId>
      <artifactId>workflow-cps</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.jenkins-ci.plugins.workflow</groupId>
      <artifactId>workflow-basic-steps</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.jenkins-ci.plugins.workflow</groupId>
      <artifactId>workflow-durable-task-step</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- Provides the `stage(...)` step for the scripted-pipeline test fixture. -->
      <groupId>org.jenkins-ci.plugins</groupId>
      <artifactId>pipeline-stage-step</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- Real-engine dialect parity tests (*IT classes). Always resolvable/compilable, but only
           actually run under the "db-it" profile (see below): Surefire's default include
           patterns skip *IT.java, and Failsafe (which does run them) isn't bound outside that
           profile, so the default `mvn -B verify` gate never touches Docker. -->
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers</artifactId>
      <version>${testcontainers.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>postgresql</artifactId>
      <version>${testcontainers.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>mariadb</artifactId>
      <version>${testcontainers.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${testcontainers.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <profiles>
    <profile>
      <!-- Full dialect-parity gate against real Postgres/MariaDB via Testcontainers:
           mvn -B verify -Pdb-it   (requires a local Docker daemon). Not part of the default
           build; intended as the pre-release / occasional CI verification gate. -->
      <id>db-it</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-failsafe-plugin</artifactId>
            <version>3.5.2</version>
            <executions>
              <execution>
                <goals>
                  <goal>integration-test</goal>
                  <goal>verify</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
