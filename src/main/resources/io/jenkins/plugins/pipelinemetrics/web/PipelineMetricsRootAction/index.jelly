<?jelly escape-by-default='false'?>
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:l="/lib/layout">
  <!--
    Rendered through Jenkins' own <l:layout> rather than as a standalone HTML document, so the
    dashboard inherits the controller's stylesheets, design tokens and light/dark theme and reads
    as part of Jenkins instead of a separate application.

    type="full-screen" gives the analytics grid the full viewport width. Note that this layout
    deliberately omits Jenkins' page header and footer (see lib/layout/layout.jelly, which skips
    <l:pageHeader> when layoutType is full-screen), which is why the explicit "Jenkins" link in
    the header below is kept — it is the only way back out of this page.

    PageDecorators still run inside <head> for every layout type, so chartjs-api injects Chart.js
    automatically here; this view no longer references chart.umd.js itself.
  -->
  <l:layout title="${%Pipeline Metrics}" type="full-screen">
    <l:header>
      <link rel="stylesheet" type="text/css"
            href="${request.contextPath}/plugin/pipeline-metrics/css/style.css"/>
    </l:header>

    <l:main-panel>
      <!-- Note: request.contextPath, not ${rootURL}. It is the one context-path accessor
           guaranteed to work in any Stapler-dispatched Jelly view; an earlier revision used
           ${rootURL} and silently rendered every asset/API URL without the context path
           (e.g. "/plugin/..." instead of "/jenkins/plugin/..."), 404ing everything whenever
           Jenkins runs under a non-root context path — which is the hpi:run default. -->
      <div id="pm-config"
           data-base="${request.contextPath}/pipeline-metrics/api"
           data-root="${request.contextPath}/"
           style="display:none"></div>
      <div class="pm-app">
        <div class="header">
          <div class="brand">
            <div class="brand-icon">⚡</div>
            <h1>Pipeline Metrics</h1>
          </div>
          <div class="header-actions">
            <a class="jenkins-button" href="${request.contextPath}/">Jenkins</a>
            <div class="sync-status">
              <div class="sync-dot"></div>
              <span id="sync-label">Live</span>
              <span id="last-updated" class="last-updated"></span>
            </div>
            <button class="jenkins-button" id="btn-export">Export CSV</button>
            <button class="jenkins-button" id="btn-sync">Sync Now</button>
            <j:if test="${it.canConfigure}">
              <button class="jenkins-button" id="btn-backfill">Backfill</button>
              <button class="jenkins-button" id="btn-import">Import…</button>
              <button class="jenkins-button" id="btn-migrate">Migrate storage…</button>
            </j:if>
          </div>
        </div>

        <div class="filters">
          <div class="jenkins-select">
            <select id="f-folder" class="jenkins-select__input"><option value="">All Environments</option></select>
          </div>
          <div class="jenkins-select">
            <select id="f-agent" class="jenkins-select__input"><option value="">All Agents</option></select>
          </div>
          <div class="jenkins-select">
            <select id="f-user" class="jenkins-select__input"><option value="">All Users</option></select>
          </div>
          <div class="filter-sep"></div>
          <div class="jenkins-select">
            <select id="f-days" class="jenkins-select__input">
              <option value="7">7 days</option>
              <option value="30" selected="selected">30 days</option>
              <option value="90">90 days</option>
              <option value="180">6 months</option>
              <option value="365">1 year</option>
            </select>
          </div>
          <div class="jenkins-select">
            <select id="f-group" class="jenkins-select__input">
              <option value="day">Daily</option>
              <option value="week">Weekly</option>
              <option value="hour">Hourly</option>
            </select>
          </div>
        </div>

        <div class="kpi-row">
          <div class="glass kpi"><div class="kpi-label">Total Builds</div><div class="kpi-value blue" id="k-total">—</div><div class="kpi-sub" id="k-total-sub"></div><div class="kpi-delta" id="k-total-delta"></div></div>
          <div class="glass kpi"><div class="kpi-label">Success Rate</div><div class="kpi-value green" id="k-success">—</div><div class="kpi-sub" id="k-success-sub"></div><div class="kpi-delta" id="k-success-delta"></div></div>
          <div class="glass kpi"><div class="kpi-label">Failure Rate</div><div class="kpi-value red" id="k-fail">—</div><div class="kpi-sub" id="k-fail-sub"></div><div class="kpi-delta" id="k-fail-delta"></div></div>
          <div class="glass kpi"><div class="kpi-label">Avg Duration</div><div class="kpi-value" id="k-dur">—</div><div class="kpi-delta" id="k-dur-delta"></div></div>
          <div class="glass kpi"><div class="kpi-label">Avg Queue</div><div class="kpi-value" id="k-queue">—</div></div>
          <div class="glass kpi"><div class="kpi-label">Slowest</div><div class="kpi-value yellow" id="k-max">—</div></div>
        </div>

        <div class="grid-2">
          <div class="glass panel">
            <div class="panel-header"><div><div class="panel-title">Build Volume</div><div class="panel-subtitle">Success vs failures over time</div></div></div>
            <canvas id="chart-volume"></canvas>
          </div>
          <div class="glass panel">
            <div class="panel-header"><div><div class="panel-title">Duration Trend</div><div class="panel-subtitle">Average build time per period</div></div></div>
            <canvas id="chart-duration"></canvas>
          </div>
        </div>

        <div class="grid-3">
          <div class="glass panel">
            <div class="panel-header"><div><div class="panel-title">Activity Heatmap</div><div class="panel-subtitle">Build frequency by day and hour</div></div></div>
            <div class="heatmap-grid" id="heatmap"></div>
          </div>
          <div class="glass panel">
            <div class="panel-header"><div><div class="panel-title">Top Triggerers</div><div class="panel-subtitle">Who triggers builds</div></div></div>
            <div id="users-list"></div>
          </div>
        </div>

        <div class="tabs-row">
          <div class="tabs">
            <div class="tab active" data-tab="pipelines">Pipelines</div>
            <div class="tab" data-tab="agents">Agents</div>
            <div class="tab" data-tab="stages">Stages</div>
          </div>
          <input id="tbl-search" class="jenkins-input tbl-search" type="text" placeholder="Filter rows…"/>
        </div>

        <div id="tab-pipelines">
          <div class="glass table-panel">
            <table>
              <thead><tr><th>Pipeline</th><th>Env</th><th>Builds</th><th>Avg Duration</th><th>Max</th><th>Queue</th><th>Failure Rate</th></tr></thead>
              <tbody id="tbl-pipelines"></tbody>
            </table>
          </div>
        </div>
        <div id="tab-agents" style="display:none">
          <div class="glass table-panel">
            <table>
              <thead><tr><th>Agent</th><th>Labels</th><th>Builds</th><th>Avg Duration</th><th>Failure Rate</th><th>Busy Time</th></tr></thead>
              <tbody id="tbl-agents"></tbody>
            </table>
          </div>
        </div>
        <div id="tab-stages" style="display:none">
          <div class="glass table-panel">
            <table>
              <thead><tr><th>Stage</th><th>Runs</th><th>Avg Duration</th><th>Max</th><th>Failure Rate</th></tr></thead>
              <tbody id="tbl-stages"></tbody>
            </table>
          </div>
        </div>
      </div>
      <script src="${request.contextPath}/plugin/pipeline-metrics/js/app.js"/>
    </l:main-panel>
  </l:layout>
</j:jelly>
