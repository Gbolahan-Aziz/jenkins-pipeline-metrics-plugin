<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:l="/lib/layout">
  <!--
    The dashboard is built from Jenkins' own components (app bar, cards, tab bar, tables, inputs,
    selects and buttons) so it looks and behaves like the rest of Jenkins and follows the active
    theme.

    type="full-screen" gives the charts the full width. That layout has no Jenkins page header,
    so the app bar keeps a link back to Jenkins.

    Styles and scripts load through <st:adjunct>, so they, and ECharts, are only added to this page.
  -->
  <l:layout title="${%Pipeline Metrics}" type="full-screen">
    <l:header>
      <st:adjunct includes="io.jenkins.plugins.echarts-common"/>
      <st:adjunct includes="io.jenkins.plugins.pipelinemetrics.web.PipelineMetricsRootAction.dashboard"/>
    </l:header>

    <l:main-panel>
      <div id="pm-config" data-base="${rootURL}/pipeline-metrics/api" hidden="hidden"></div>

      <div class="pm-app">
        <l:app-bar title="${%Pipeline Metrics}">
          <div class="pm-sync-status">
            <span class="pm-sync-dot"></span>
            <span id="sync-label">Live</span>
            <span id="last-updated"></span>
          </div>
          <a class="jenkins-button" href="${rootURL}/">Jenkins</a>
          <button type="button" class="jenkins-button" id="btn-export">Export CSV</button>
          <button type="button" class="jenkins-button" id="btn-sync">Sync now</button>
          <j:if test="${it.canConfigure}">
            <button type="button" class="jenkins-button" id="btn-backfill">Backfill</button>
            <button type="button" class="jenkins-button" id="btn-import">Import…</button>
            <button type="button" class="jenkins-button" id="btn-migrate">Migrate storage…</button>
          </j:if>
        </l:app-bar>

        <div class="pm-filters">
          <div class="jenkins-select">
            <select id="f-folder" class="jenkins-select__input" aria-label="Folder">
              <option value="">All environments</option>
            </select>
          </div>
          <div class="jenkins-select">
            <select id="f-agent" class="jenkins-select__input" aria-label="Agent">
              <option value="">All agents</option>
            </select>
          </div>
          <div class="jenkins-select">
            <select id="f-user" class="jenkins-select__input" aria-label="User">
              <option value="">All users</option>
            </select>
          </div>
          <span class="pm-filter-sep"></span>
          <div class="jenkins-select">
            <select id="f-days" class="jenkins-select__input" aria-label="Period">
              <option value="7">7 days</option>
              <option value="30" selected="selected">30 days</option>
              <option value="90">90 days</option>
              <option value="180">6 months</option>
              <option value="365">1 year</option>
            </select>
          </div>
          <div class="jenkins-select">
            <select id="f-group" class="jenkins-select__input" aria-label="Group by">
              <option value="day">Daily</option>
              <option value="week">Weekly</option>
              <option value="hour">Hourly</option>
            </select>
          </div>
        </div>

        <div class="pm-kpi-row">
          <l:card title="${%Total builds}">
            <div class="pm-kpi-value pm-blue" id="k-total">—</div>
            <div class="pm-kpi-sub" id="k-total-sub"></div>
            <div class="pm-kpi-delta" id="k-total-delta"></div>
          </l:card>
          <l:card title="${%Success rate}">
            <div class="pm-kpi-value pm-green" id="k-success">—</div>
            <div class="pm-kpi-sub" id="k-success-sub"></div>
            <div class="pm-kpi-delta" id="k-success-delta"></div>
          </l:card>
          <l:card title="${%Failure rate}">
            <div class="pm-kpi-value pm-red" id="k-fail">—</div>
            <div class="pm-kpi-sub" id="k-fail-sub"></div>
            <div class="pm-kpi-delta" id="k-fail-delta"></div>
          </l:card>
          <l:card title="${%Average duration}">
            <div class="pm-kpi-value" id="k-dur">—</div>
            <div class="pm-kpi-delta" id="k-dur-delta"></div>
          </l:card>
          <l:card title="${%Average queue}">
            <div class="pm-kpi-value" id="k-queue">—</div>
          </l:card>
          <l:card title="${%Slowest}">
            <div class="pm-kpi-value pm-yellow" id="k-max">—</div>
          </l:card>
        </div>

        <div class="pm-grid-2">
          <l:card title="${%Build volume}">
            <div class="pm-chart" id="chart-volume"></div>
          </l:card>
          <l:card title="${%Duration trend}">
            <div class="pm-chart" id="chart-duration"></div>
          </l:card>
        </div>

        <div class="pm-grid-3">
          <l:card title="${%Activity by day and hour}">
            <div class="pm-heatmap" id="heatmap"></div>
          </l:card>
          <l:card title="${%Top triggerers}">
            <div id="users-list"></div>
          </l:card>
        </div>

        <div class="pm-tabs-row">
          <div id="pm-tabs">
            <l:tabBar>
              <l:tab name="${%Pipelines}" href="#pipelines" active="true"/>
              <l:tab name="${%Agents}" href="#agents"/>
              <l:tab name="${%Stages}" href="#stages"/>
            </l:tabBar>
          </div>
          <input id="tbl-search" class="jenkins-input pm-tbl-search" type="search"
                 placeholder="${%Filter rows}" aria-label="${%Filter rows}"/>
        </div>

        <div id="pm-panel-pipelines" class="pm-panel">
          <table class="jenkins-table jenkins-table--small">
            <thead>
              <tr><th>Pipeline</th><th>Environment</th><th>Builds</th><th>Average duration</th><th>Max</th><th>Queue</th><th>Failure rate</th></tr>
            </thead>
            <tbody id="tbl-pipelines"></tbody>
          </table>
        </div>
        <div id="pm-panel-agents" class="pm-panel" hidden="hidden">
          <table class="jenkins-table jenkins-table--small">
            <thead>
              <tr><th>Agent</th><th>Labels</th><th>Builds</th><th>Average duration</th><th>Failure rate</th><th>Busy time</th></tr>
            </thead>
            <tbody id="tbl-agents"></tbody>
          </table>
        </div>
        <div id="pm-panel-stages" class="pm-panel" hidden="hidden">
          <table class="jenkins-table jenkins-table--small">
            <thead>
              <tr><th>Stage</th><th>Runs</th><th>Average duration</th><th>Max</th><th>Failure rate</th></tr>
            </thead>
            <tbody id="tbl-stages"></tbody>
          </table>
        </div>
      </div>
    </l:main-panel>
  </l:layout>
</j:jelly>
