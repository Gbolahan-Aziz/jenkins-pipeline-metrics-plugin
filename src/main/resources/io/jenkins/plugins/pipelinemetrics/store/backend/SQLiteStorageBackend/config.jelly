<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
  <f:entry>
    <div class="jenkins-!-color-secondary">
      Embedded SQLite under <code>$JENKINS_HOME/pipeline-metrics/metrics.db</code>. No
      configuration needed. Not recommended when <code>$JENKINS_HOME</code> is on network storage
      (NFS/EFS) or shared by more than one controller process — pick an external database instead.
    </div>
  </f:entry>
</j:jelly>
