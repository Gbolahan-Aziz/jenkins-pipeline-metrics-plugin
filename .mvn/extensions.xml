<?xml version="1.0" encoding="UTF-8"?>
<extensions>
  <extension>
    <!-- Computes the "changelist" property from git state (e.g. -rc123.abcdef0 for a CI build,
         empty for a tagged release), so ${revision}${changelist} in pom.xml gives every build a
         unique, traceable version without hand-bumping <version> per release. Required for the
         Jenkins project's incrementals/continuous-delivery pipeline once this repo is hosted
         under jenkinsci. -->
    <groupId>io.jenkins.tools.incrementals</groupId>
    <artifactId>git-changelist-maven-extension</artifactId>
    <version>1.8</version>
  </extension>
</extensions>
