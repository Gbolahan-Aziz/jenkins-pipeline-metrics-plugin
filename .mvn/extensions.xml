<?xml version="1.0" encoding="UTF-8"?>
<extensions xmlns="http://maven.apache.org/EXTENSIONS/1.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
            xsi:schemaLocation="http://maven.apache.org/EXTENSIONS/1.0.0 https://maven.apache.org/xsd/core-extensions-1.0.0.xsd">
  <extension>
    <!-- Computes the "changelist" property from git state (e.g. a CI build gets a unique
         incremental version, a tagged release gets a clean one), so ${changelist} in pom.xml
         gives every build a unique, traceable version without hand-bumping <version> per
         release. Required for the Jenkins project's incrementals/continuous-delivery pipeline. -->
    <groupId>io.jenkins.tools.incrementals</groupId>
    <artifactId>git-changelist-maven-extension</artifactId>
    <version>1.13</version>
  </extension>
</extensions>
